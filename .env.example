# ==========================================
# UPSTORE ENVIRONMENT CONFIGURATION (.env)
# ==========================================

# ── 1. SUPABASE (Database & Authentication) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── 2. SITE URL & DOMAIN ──
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ── 3. BYBIT API V5 & SMART CRYPTO GATEWAY ──
# Whitelisted Bybit IP: 156.204.227.116
BYBIT_API_KEY=your-bybit-api-key
BYBIT_API_SECRET=your-bybit-api-secret
BYBIT_UID=47183921
BYBIT_TESTNET=false
# Optional forward proxy if Vercel serverless requires fixed IP egress:
# BYBIT_PROXY_URL=http://156.204.227.116:8080
BYBIT_USDT_TRC20=TW4z3c4PZ2Gk5YQ7nN9x8vK1mB5qP9R2e1
BYBIT_USDT_BEP20=0x71C836e520023a1B3a0279612301A949826a7C10
BYBIT_USDT_TON=EQBvW8m53GoU_jPAIp7LwY8Gj044kX_613p_dC6lQ1_y9Z1X
BINANCE_PAY_ID=382910482

# ── 4. EGYPT PAYMENT GATEWAYS (INSTAPAY & WALLETS) ──
INSTAPAY_ADDRESS=upstore@instapay
VODAFONE_CASH_NUMBER=01098765432
ORANGE_CASH_NUMBER=01234567890
ETISALAT_CASH_NUMBER=01123456789
FAWRY_MERCHANT_CODE=984120

# ── 5. SAUDI ARABIA PAYMENT GATEWAYS (STC PAY & BANKS) ──
STC_PAY_NUMBER=0551234567
URPAY_NUMBER=0551234567
ALRAJHI_IBAN=SA0380000000608010167519
SNB_IBAN=SA4410000001234567890123

# ── 6. STRIPE (CREDIT CARDS & APPLE PAY) ──
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── 7. BTCPAY SERVER (DECENTRALIZED CRYPTO) ──
BTCPAY_SERVER_URL=https://your-btcpay-server.com
BTCPAY_API_KEY=your-btcpay-api-key
BTCPAY_STORE_ID=your-btcpay-store-id
BTCPAY_WEBHOOK_SECRET=your-btcpay-webhook-secret

# ── 8. NOWPAYMENTS (300+ CRYPTO SUITE & CARDS) ──
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret-key
NOWPAYMENTS_SANDBOX=false

# ── 9. LEMON SQUEEZY (CARDS, APPLE PAY, PAYPAL) ──
LEMONSQUEEZY_API_KEY=eyJ0eXAi...
LEMONSQUEEZY_STORE_ID=457660
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── 10. CRYPTOMUS MULTI-GATEWAY ──
CRYPTOMUS_MERCHANT_UUID=your-cryptomus-merchant-uuid
CRYPTOMUS_API_KEY=your-cryptomus-api-key

# ── 10. TELEGRAM SUPPORT BOT ──
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=UpStore_Support_bot
NEXT_PUBLIC_TELEGRAM_SUPPORT_BOT=UpStore_Support_bot
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ── 9. ZELENKA AUTO-DELIVERY API ──
ZELENKA_API_KEY=your-zelenka-api-key

# ── 10. DEEPSEEK AI ENGINE ──
DEEPSEEK_API_KEY=your-deepseek-api-key
NEXT_PUBLIC_DEEPSEEK_MODEL=deepseek-v4-flash
